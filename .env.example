# Copy this file to ".env" and fill in values. ".env" is ignored by git, so secrets stay on your computer.
# Phase 1 needs NO keys: prices come from free sources. These are placeholders for later phases.

# Optional backup data provider (not used yet)
# ALPHAVANTAGE_API_KEY=

# Paper-trading account (phase 3+, PAPER ONLY, never a live account)
# PAPER_BROKER_API_KEY=
# PAPER_BROKER_API_SECRET=
